    <Sequence DisplayName="Parsers — When">
      <ui:InvokeCode Language="CSharp" Code="var respostaConteudo = &quot;```json\n{ \&quot;legenda\&quot;: \&quot;3 benefícios da limpeza de pele ✨\&quot;, \&quot;hashtags\&quot;: [\&quot;skincare\&quot;, \&quot;estetica\&quot;, \&quot;limpezadepele\&quot;], \&quot;mediaPrompt\&quot;: \&quot;foto clínica clean\&quot; }\n```&quot;;&#xA;var gerado = clarituz_agente_social_midia.ConteudoService.ParsearConteudoGerado(respostaConteudo);&#xA;legenda = gerado.Legenda;&#xA;nHashtags = gerado.Hashtags == null ? -1 : gerado.Hashtags.Length;&#xA;mediaPrompt = gerado.MediaPrompt;&#xA;&#xA;var respostaPautas = &quot;Aqui estão as pautas:\n```json\n[{\&quot;tema\&quot;: \&quot;pauta um\&quot;, \&quot;mediaUrl\&quot;: null}, {\&quot;tema\&quot;: \&quot;pauta dois\&quot;, \&quot;mediaUrl\&quot;: null}, {\&quot;tema\&quot;: \&quot;pauta três\&quot;, \&quot;mediaUrl\&quot;: null}]\n```\nEspero que ajude!&quot;;&#xA;var pautas = clarituz_agente_social_midia.ConteudoService.ParsearPautas(respostaPautas);&#xA;nPautas = pautas == null ? -1 : pautas.Count;&#xA;pauta1 = nPautas &gt; 0 &amp;&amp; pautas[0][&quot;tema&quot;] != null ? pautas[0][&quot;tema&quot;].ToString() : &quot;&quot;;&#xA;&#xA;try { clarituz_agente_social_midia.ConteudoService.ParsearConteudoGerado(&quot;   &quot;); throwVazio = false; }&#xA;catch (FormatException) { throwVazio = true; }&#xA;try { clarituz_agente_social_midia.ConteudoService.ParsearConteudoGerado(&quot;texto sem json nenhum&quot;); throwSemJson = false; }&#xA;catch (FormatException) { throwSemJson = true; }&#xA;&#xA;var respostaCal = &quot;```json\n[{\&quot;data\&quot;: \&quot;2099-01-01\&quot;, \&quot;tema\&quot;: \&quot;post A\&quot;, \&quot;plataforma\&quot;: \&quot;Instagram\&quot;, \&quot;formato\&quot;: \&quot;feed\&quot;, \&quot;objetivo\&quot;: \&quot;engajar\&quot;}, {\&quot;data\&quot;: \&quot;2099-01-02\&quot;, \&quot;tema\&quot;: \&quot;post B\&quot;, \&quot;plataforma\&quot;: \&quot;Facebook\&quot;, \&quot;formato\&quot;: \&quot;carrossel\&quot;, \&quot;objetivo\&quot;: \&quot;converter\&quot;}]\n```&quot;;&#xA;var cal = clarituz_agente_social_midia.ConteudoService.ParsearCalendario(respostaCal);&#xA;nEntradasCal = cal == null ? -1 : cal.Count;&#xA;nHojeCal = clarituz_agente_social_midia.ConteudoService.EntradasDoDia(cal, new DateTime(2099, 1, 1)).Count;&#xA;try { clarituz_agente_social_midia.ConteudoService.ParsearCalendario(&quot;[{\&quot;tema\&quot;: \&quot;sem data\&quot;}]&quot;); throwCalInvalido = false; }&#xA;catch (FormatException) { throwCalInvalido = true; }" DisplayName="Executar parsers" sap2010:WorkflowViewState.IdRef="InvokeCode_run">
