    </Sequence>
    <Sequence DisplayName="Zero-write — When">
      <ui:InvokeCode Language="CSharp" Code="var raiz = Directory.GetCurrentDirectory();&#xA;for (var i = 0; i &lt; 6 &amp;&amp; !File.Exists(Path.Combine(raiz, &quot;Workflows&quot;, &quot;SocialApiClient.cs&quot;)); i++)&#xA;    raiz = Directory.GetParent(raiz).FullName;&#xA;&#xA;var proibidos = new[]&#xA;{&#xA;    &quot;HttpMethod.Post&quot;, &quot;HttpMethod.Put&quot;, &quot;HttpMethod.Delete&quot;, &quot;HttpMethod.Patch&quot;,&#xA;    &quot;.PostAsync(&quot;, &quot;.PutAsync(&quot;, &quot;.DeleteAsync(&quot;, &quot;.PatchAsync(&quot;,&#xA;    &quot;Method=\&quot;POST\&quot;&quot;, &quot;Method=\&quot;PUT\&quot;&quot;, &quot;Method=\&quot;DELETE\&quot;&quot;, &quot;Method=\&quot;PATCH\&quot;&quot;,&#xA;    &quot;Method=\&quot;Post\&quot;&quot;, &quot;Method=\&quot;Put\&quot;&quot;, &quot;Method=\&quot;Delete\&quot;&quot;, &quot;Method=\&quot;Patch\&quot;&quot;&#xA;};&#xA;&#xA;var arquivos = new List&lt;string&gt;();&#xA;foreach (var pasta in new[] { &quot;Workflows&quot;, &quot;logica&quot;, &quot;shared&quot;, &quot;Framework&quot; })&#xA;{&#xA;    var dir = Path.Combine(raiz, pasta);&#xA;    if (!Directory.Exists(dir)) continue;&#xA;    arquivos.AddRange(Directory.GetFiles(dir, &quot;*.cs&quot;));&#xA;    arquivos.AddRange(Directory.GetFiles(dir, &quot;*.xaml&quot;));&#xA;}&#xA;var main = Path.Combine(raiz, &quot;Main.xaml&quot;);&#xA;if (File.Exists(main)) arquivos.Add(main);&#xA;&#xA;var hits = new List&lt;string&gt;();&#xA;foreach (var arq in arquivos.Where(a =&gt; !Path.GetFileName(a).StartsWith(&quot;~&quot;)))&#xA;{&#xA;    var texto = File.ReadAllText(arq);&#xA;    var ehPowerBi = Path.GetFileName(arq).IndexOf(&quot;PowerBi&quot;, StringComparison.OrdinalIgnoreCase) &gt;= 0;&#xA;    var destinoPermitido = ehPowerBi &amp;&amp; texto.Contains(&quot;api.powerbi.com&quot;);&#xA;    foreach (var padrao in proibidos)&#xA;        if (texto.Contains(padrao) &amp;&amp; !destinoPermitido)&#xA;            hits.Add(Path.GetFileName(arq) + &quot;: &quot; + padrao);&#xA;}&#xA;&#xA;escaneados = arquivos.Count;&#xA;ocorrencias = hits.Count;&#xA;detalhes = hits.Count == 0 ? &quot;(nenhuma ocorrência)&quot; : string.Join(&quot; | &quot;, hits);&#xA;temGet = File.ReadAllText(Path.Combine(raiz, &quot;Workflows&quot;, &quot;SocialApiClient.cs&quot;)).Contains(&quot;HttpMethod.Get&quot;);" DisplayName="Escanear fontes por escrita HTTP" sap2010:WorkflowViewState.IdRef="InvokeCode_scan">
