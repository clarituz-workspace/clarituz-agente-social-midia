      <ui:InvokeCode Code="comentarios = new JArray();&#xA;var agora = DateTime.UtcNow;&#xA;var novo = new JObject();&#xA;var cfg = ctx.ContainsKey(&quot;Config&quot;) ? ctx[&quot;Config&quot;] as JObject : new JObject();&#xA;JObject ultimo;&#xA;try { ultimo = string.IsNullOrEmpty(ultimoRaw) ? new JObject() : JObject.Parse(ultimoRaw); } catch { ultimo = new JObject(); }&#xA;&#xA;using (var api = new clarituz_agente_social_midia.SocialApiClient(metaSecure, linkedInSecure))&#xA;{&#xA;    // Instagram: mídias recentes → comentários após último poll&#xA;    var igUser = cfg[&quot;ig_user_id&quot;] != null ? cfg[&quot;ig_user_id&quot;].ToString() : null;&#xA;    if (!string.IsNullOrEmpty(igUser))&#xA;    {&#xA;        var desdeIg = ultimo[&quot;instagram&quot;] == null ? agora.AddDays(-1) : DateTime.Parse(ultimo[&quot;instagram&quot;].ToString());&#xA;        var midias = api.ObterMidiasRecentesInstagramAsync(igUser).GetAwaiter().GetResult();&#xA;        foreach (var m in midias[&quot;data&quot;] ?? new JArray())&#xA;        {&#xA;            var mid = m[&quot;id&quot;].ToString();&#xA;            var com = api.ObterComentariosMetaAsync(mid).GetAwaiter().GetResult();&#xA;            foreach (var c in com[&quot;data&quot;] ?? new JArray())&#xA;            {&#xA;                DateTime ts;&#xA;                if (!DateTime.TryParse(c[&quot;timestamp&quot;] != null ? c[&quot;timestamp&quot;].ToString() : &quot;&quot;, out ts)) continue;&#xA;                if (ts &gt; desdeIg)&#xA;                    comentarios.Add(new JObject { [&quot;commentId&quot;] = c[&quot;id&quot;].ToString(), [&quot;texto&quot;] = c[&quot;text&quot;] == null ? &quot;&quot; : c[&quot;text&quot;].ToString(), [&quot;autor&quot;] = c[&quot;username&quot;] == null ? &quot;&quot; : c[&quot;username&quot;].ToString(), [&quot;plataforma&quot;] = &quot;Instagram&quot;, [&quot;postId&quot;] = mid });&#xA;            }&#xA;        }&#xA;        novo[&quot;instagram&quot;] = agora.ToString(&quot;o&quot;);&#xA;    }&#xA;&#xA;    // Facebook: feed da página → comentários após último poll&#xA;    var fbPage = cfg[&quot;fb_page_id&quot;] != null ? cfg[&quot;fb_page_id&quot;].ToString() : null;&#xA;    if (!string.IsNullOrEmpty(fbPage))&#xA;    {&#xA;        var desdeFb = ultimo[&quot;facebook&quot;] == null ? agora.AddDays(-1) : DateTime.Parse(ultimo[&quot;facebook&quot;].ToString());&#xA;        var feed = api.ObterFeedFacebookAsync(fbPage).GetAwaiter().GetResult();&#xA;        foreach (var p in feed[&quot;data&quot;] ?? new JArray())&#xA;        {&#xA;            var pid = p[&quot;id&quot;].ToString();&#xA;            var com = api.ObterComentariosMetaAsync(pid).GetAwaiter().GetResult();&#xA;            foreach (var c in com[&quot;data&quot;] ?? new JArray())&#xA;            {&#xA;                DateTime ts;&#xA;                if (!DateTime.TryParse(c[&quot;created_time&quot;] != null ? c[&quot;created_time&quot;].ToString() : &quot;&quot;, out ts)) continue;&#xA;                if (ts &gt; desdeFb)&#xA;                    comentarios.Add(new JObject { [&quot;commentId&quot;] = c[&quot;id&quot;].ToString(), [&quot;texto&quot;] = c[&quot;message&quot;] == null ? &quot;&quot; : c[&quot;message&quot;].ToString(), [&quot;autor&quot;] = c[&quot;from&quot;] != null &amp;&amp; c[&quot;from&quot;][&quot;name&quot;] != null ? c[&quot;from&quot;][&quot;name&quot;].ToString() : &quot;&quot;, [&quot;plataforma&quot;] = &quot;Facebook&quot;, [&quot;postId&quot;] = pid });&#xA;            }&#xA;        }&#xA;        novo[&quot;facebook&quot;] = agora.ToString(&quot;o&quot;);&#xA;    }&#xA;&#xA;    // LinkedIn: posts da org → comentários (created.time em ms epoch)&#xA;    var liOrg = cfg[&quot;linkedin_org_urn&quot;] != null ? cfg[&quot;linkedin_org_urn&quot;].ToString() : null;&#xA;    if (!string.IsNullOrEmpty(liOrg))&#xA;    {&#xA;        var desdeLi = ultimo[&quot;linkedin&quot;] == null ? agora.AddDays(-1) : DateTime.Parse(ultimo[&quot;linkedin&quot;].ToString());&#xA;        var posts = api.ObterPostsLinkedInAsync(liOrg).GetAwaiter().GetResult();&#xA;        foreach (var p in posts[&quot;elements&quot;] ?? new JArray())&#xA;        {&#xA;            var urn = p[&quot;id&quot;] != null ? p[&quot;id&quot;].ToString() : p[&quot;shareUrn&quot;] != null ? p[&quot;shareUrn&quot;].ToString() : null;&#xA;            if (urn == null) continue;&#xA;            var com = api.ObterComentariosLinkedInAsync(urn).GetAwaiter().GetResult();&#xA;            foreach (var c in com[&quot;elements&quot;] ?? new JArray())&#xA;            {&#xA;                long ms;&#xA;                var msTok = c[&quot;created&quot;] != null &amp;&amp; c[&quot;created&quot;][&quot;time&quot;] != null ? c[&quot;created&quot;][&quot;time&quot;] : null;&#xA;                if (msTok == null || !long.TryParse(msTok.ToString(), out ms)) continue;&#xA;                var ts = DateTimeOffset.FromUnixTimeMilliseconds(ms).UtcDateTime;&#xA;                if (ts &gt; desdeLi)&#xA;                    comentarios.Add(new JObject { [&quot;commentId&quot;] = c[&quot;id&quot;] != null ? c[&quot;id&quot;].ToString() : urn + &quot;:&quot; + ms, [&quot;texto&quot;] = c[&quot;message&quot;] != null &amp;&amp; c[&quot;message&quot;][&quot;text&quot;] != null ? c[&quot;message&quot;][&quot;text&quot;].ToString() : (c[&quot;text&quot;] != null &amp;&amp; c[&quot;text&quot;][&quot;text&quot;] != null ? c[&quot;text&quot;][&quot;text&quot;].ToString() : &quot;&quot;), [&quot;autor&quot;] = c[&quot;actor&quot;] != null ? c[&quot;actor&quot;].ToString() : &quot;&quot;, [&quot;plataforma&quot;] = &quot;LinkedIn&quot;, [&quot;postId&quot;] = urn });&#xA;            }&#xA;        }&#xA;        novo[&quot;linkedin&quot;] = agora.ToString(&quot;o&quot;);&#xA;    }&#xA;}&#xA;novoPoll = novo.ToString();" DisplayName="Poll comentários IG/FB/LI (read-only)" sap2010:WorkflowViewState.IdRef="InvokeCode_poll">
