    <ui:InvokeCode Language="CSharp" Code="var sb = new System.Text.StringBuilder();&#xA;foreach (var l in (jsonl ?? &quot;&quot;).Split(new[] { '\n' }, StringSplitOptions.RemoveEmptyEntries))&#xA;{&#xA;    var t = l.Trim();&#xA;    if (t.Length == 0) continue;&#xA;    try&#xA;    {&#xA;        var o = JObject.Parse(t);&#xA;        if (o[&quot;PostId&quot;] != null &amp;&amp; o[&quot;PostId&quot;].ToString() == postId) continue;&#xA;    }&#xA;    catch { }&#xA;    sb.AppendLine(t);&#xA;}&#xA;sb.AppendLine(linha);&#xA;jsonlNovo = sb.ToString();" DisplayName="Upsert por postId (BR-13)" sap2010:WorkflowViewState.IdRef="InvokeCode_upsert">
