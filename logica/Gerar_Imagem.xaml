    <ui:InvokeCode Language="CSharp" Code="var cfg = ctx.ContainsKey(&quot;Config&quot;) ? ctx[&quot;Config&quot;] as JObject : new JObject();&#xA;habilitada = cfg[&quot;gerar_imagem&quot;] != null &amp;&amp; cfg[&quot;gerar_imagem&quot;].ToObject&lt;bool&gt;();&#xA;modelo = cfg[&quot;imagem_modelo&quot;] == null ? &quot;gpt-image-1&quot; : cfg[&quot;imagem_modelo&quot;].ToString();&#xA;tamanho = cfg[&quot;imagem_tamanho&quot;] == null ? &quot;1024x1024&quot; : cfg[&quot;imagem_tamanho&quot;].ToString();&#xA;qualidade = cfg[&quot;imagem_qualidade&quot;] == null ? &quot;high&quot; : cfg[&quot;imagem_qualidade&quot;].ToString();&#xA;qa = cfg[&quot;imagem_qa&quot;] == null || cfg[&quot;imagem_qa&quot;].ToObject&lt;bool&gt;();&#xA;var tp = new List&lt;string&gt;();&#xA;if (cfg[&quot;termos_proibidos&quot;] != null) foreach (var t in cfg[&quot;termos_proibidos&quot;]) tp.Add(t.ToString());&#xA;termos = string.Join(&quot;, &quot;, tp);&#xA;var mediaJaInformada = inData != null &amp;&amp; JObject.FromObject(inData)[&quot;MediaUrl&quot;] != null &amp;&amp; !string.IsNullOrWhiteSpace(JObject.FromObject(inData)[&quot;MediaUrl&quot;].ToString());&#xA;prompt = conteudo == null || conteudo[&quot;MediaPrompt&quot;] == null ? &quot;&quot; : conteudo[&quot;MediaPrompt&quot;].ToString();&#xA;if (mediaJaInformada || string.IsNullOrWhiteSpace(prompt)) habilitada = false;" DisplayName="Config + decide se gera imagem" sap2010:WorkflowViewState.IdRef="InvokeCode_cfg">
