          <ui:InvokeCode Language="CSharp" Code="erro = null;&#xA;try&#xA;{&#xA;    nomeArquivo = &quot;img-&quot; + DateTime.UtcNow.Ticks + &quot;.png&quot;;&#xA;    var bytes = clarituz_agente_social_midia.ImagemService.GerarImagemAsync(apiKey, prompt, modelo, tamanho, qualidade).GetAwaiter().GetResult();&#xA;    notaQa = null;&#xA;    if (qa)&#xA;    {&#xA;        var aval = clarituz_agente_social_midia.ImagemService.AvaliarImagemAsync(apiKey, bytes, prompt, termos).GetAwaiter().GetResult();&#xA;        var ok = aval[&quot;aprovada&quot;] != null &amp;&amp; aval[&quot;aprovada&quot;].ToObject&lt;bool&gt;();&#xA;        notaQa = aval[&quot;motivo&quot;] == null ? null : aval[&quot;motivo&quot;].ToString();&#xA;        if (!ok)&#xA;        {&#xA;            var bytes2 = clarituz_agente_social_midia.ImagemService.GerarImagemAsync(apiKey, prompt, modelo, tamanho, qualidade).GetAwaiter().GetResult();&#xA;            var aval2 = clarituz_agente_social_midia.ImagemService.AvaliarImagemAsync(apiKey, bytes2, prompt, termos).GetAwaiter().GetResult();&#xA;            if (aval2[&quot;aprovada&quot;] != null &amp;&amp; aval2[&quot;aprovada&quot;].ToObject&lt;bool&gt;()) { bytes = bytes2; notaQa = aval2[&quot;motivo&quot;] == null ? null : aval2[&quot;motivo&quot;].ToString(); }&#xA;            else notaQa = &quot;QA reprovou 2x: &quot; + (aval2[&quot;motivo&quot;] == null ? notaQa : aval2[&quot;motivo&quot;].ToString());&#xA;        }&#xA;        if (conteudo != null) conteudo[&quot;NotaImagemQA&quot;] = notaQa;&#xA;    }&#xA;    caminho = Path.Combine(Path.GetTempPath(), nomeArquivo);&#xA;    File.WriteAllBytes(caminho, bytes);&#xA;}&#xA;catch (Exception ex) { erro = ex.Message; }" DisplayName="OpenAI Images → QA visual → arquivo temp" sap2010:WorkflowViewState.IdRef="InvokeCode_gen">
